<Project Sdk="Microsoft.NET.Sdk">

  <!-- Consumes the packed VSOP87.NET nupkg from ../artifacts (see nuget.config). Not part of the solution. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VsopVersion Condition="'$(VsopVersion)' == ''">3.0.0</VsopVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="VSOP87.NET" Version="$(VsopVersion)" />
  </ItemGroup>

</Project>
